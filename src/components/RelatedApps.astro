---
// "More like this" row linking the live apps to each other.
import { projects } from "../data/projects.js";

interface Props {
  current: string;
}
const { current } = Astro.props;
const family = ["/trace", "/fingerprint", "/sky", "/planet"];
const related = family
  .filter((url) => url !== current)
  .map((url) => projects.find((p) => p.url === url))
  .filter(Boolean);
---

<nav class="related" aria-label="More like this">
  <h2 class="related-title">More like this</h2>
  <ul class="related-list">
    {
      related.map((p) => (
        <li>
          <a class="related-card" href={p.url}>
            <span class="related-icon" set:html={p.icon} />
            <span class="related-text">
              <span class="related-name">{p.name}</span>
              <span class="related-desc">{p.description}</span>
            </span>
          </a>
        </li>
      ))
    }
  </ul>
</nav>

<style>
  .related {
    width: 100%;
    max-width: 1100px;
    margin: 0 auto;
    padding: 32px 16px 40px;
  }

  .related-title {
    margin: 0 0 12px;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: #94a3b8;
  }

  .related-list {
    display: grid;
    gap: 12px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  @media (min-width: 720px) {
    .related-list {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .related-card {
    display: flex;
    gap: 12px;
    height: 100%;
    padding: 14px 16px;
    border: 1px solid rgba(148, 163, 184, 0.16);
    border-radius: 14px;
    background: rgba(10, 12, 16, 0.78);
    color: #e2e8f0;
    text-decoration: none;
    transition: border-color 0.2s, transform 0.2s;
  }

  .related-card:hover,
  .related-card:focus-visible {
    border-color: rgba(239, 68, 68, 0.5);
    transform: translateY(-2px);
  }

  .related-icon {
    flex-shrink: 0;
    width: 22px;
    height: 22px;
    color: #ef4444;
  }

  .related-icon :global(svg) {
    width: 100%;
    height: 100%;
  }

  .related-text {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .related-name {
    font-weight: 600;
  }

  .related-desc {
    font-size: 0.85rem;
    line-height: 1.45;
    color: #94a3b8;
  }

  @media (prefers-reduced-motion: reduce) {
    .related-card {
      transition: none;
    }

    .related-card:hover,
    .related-card:focus-visible {
      transform: none;
    }
  }
</style>
